# Copy to .env and fill in.
HUM_USER=admin
HUM_PASSWORD=change-me

# Free key from https://devportal.jamendo.com (enables Discover / free music)
JAMENDO_CLIENT_ID=

# Optional
# PORT=4533
# MUSIC_DIR=./music
# DATA_DIR=./data
# LRCLIB_ENABLED=true     # look up lyrics on lrclib.net when a song has none
# MAX_UPLOAD_MB=500
